{
  "expo": {
    "name": "Safe Space Saturdays",
    "slug": "safe-space-saturdays",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "safespacesaturdays",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safespacesaturdays.app"
    },
    "android": {
      "package": "com.safespacesaturdays.app",
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "422e6dd0-e02b-4b12-ac27-d66ae64a9f30"
      }
    },
    "owner": "sly_rese"
  }
}
