{
  "name": "safe-space-saturdays-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "start": "node server.mjs",
    "generate-routes": "tsr generate",
    "typecheck": "npm run generate-routes && tsc --noEmit",
    "build": "vite build",
    "test": "vitest run --exclude='e2e/**'",
    "visual:capture": "playwright test",
    "ui:check": "playwright test e2e/ui-quality.spec.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run ui:check && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.27",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.18",
    "@tanstack/router-plugin": "1.168.19",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.4",
    "prettier": "3.9.5",
    "typescript": "6.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
