# Safe Space Saturdays environment template
# Copy this file to .env for local development. Never commit the copied .env.

# -----------------------------------------------------------------------------
# Render automation (used by the deployment command from your own terminal)
# -----------------------------------------------------------------------------
# Get this from Render Dashboard > Account Settings > API Keys.
# Keep it local-only; never put it in render.yaml or a Render service variable.
RENDER_API_KEY=replace-with-render-api-key

# Render workspace ID. Get it from Render Dashboard > Workspace Settings,
# or query https://api.render.com/v1/owners with the API key above.
RENDER_OWNER_ID=replace-with-render-workspace-id

# GitHub repository and branch that Render should deploy.
# The Render GitHub integration must have access to this repository.
GITHUB_REPO=https://github.com/your-account/your-repository.git
GITHUB_BRANCH=pre-prod

# -----------------------------------------------------------------------------
# API service: local defaults
# -----------------------------------------------------------------------------
APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
COOKIE_SECURE=false
SESSION_COOKIE_NAME=safe_space_session
SESSION_TTL_DAYS=30
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5000000

# -----------------------------------------------------------------------------
# Frontend service: local defaults
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Local Docker/PostgreSQL only
# -----------------------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000

# -----------------------------------------------------------------------------
# Render production overrides
# Add these in the Render service Environment settings or Blueprint.
# Do not use localhost values in production.
# -----------------------------------------------------------------------------
# API service:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# API_CORS_ORIGINS=["https://your-web-service.onrender.com"]
# COOKIE_SECURE=true
# UPLOAD_DIR=/var/data/uploads
#
# Frontend service:
# VITE_API_URL=https://your-api-service.onrender.com
#
# Render gives the Postgres connectionString as postgresql://... . This app
# uses SQLAlchemy async Psycopg, so use the same value with the prefix changed
# to postgresql+psycopg://... before saving DATABASE_URL.
# Attach a Render persistent disk at /var/data if using local upload storage.
# Object storage is preferred for scalable production uploads.

# -----------------------------------------------------------------------------
# Optional future infrastructure
# -----------------------------------------------------------------------------
# The current application does not read REDIS_URL yet. Add it only after the
# games/realtime module has Redis integration.
# REDIS_URL=redis://...
#
# If object storage is implemented later, add the provider-specific variables
# here and keep them as secret Render environment variables, not repository data.
# STORAGE_BUCKET=...
# STORAGE_ENDPOINT=...
# STORAGE_REGION=...
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_SECRET_ACCESS_KEY=...
